# Scout Router configuration. Copy to .env and fill in. Never commit .env.

# --- Chain ---
# 11142220 = Celo Sepolia (dev). 42220 = Celo Mainnet (submission).
CHAIN_ID=11142220
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# --- Settlement asset ---
# Defaults match the official x402 default asset table. Override only if you
# know the x402 layer and the escrow must use a different asset (not advised:
# the router refuses a USDC_ADDRESS outside the table default for its network).
# USDC_ADDRESS=
USDC_DECIMALS=6

# --- Scout contracts (fill after deploy) ---
SCOUT_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# First block to scan for Scout events. Fill after deploy to keep log queries
# fast on Mainnet. Leave unset to scan from earliest (slow but works).
# SCOUT_ESCROW_DEPLOY_BLOCK=

# --- Router agent wallet ---
# x402 payments settle here, and bounties are funded from here, so this MUST be
# the router agent wallet address in both roles.
ROUTER_PAY_TO=0x0000000000000000000000000000000000000000

# --- Router signing (pick one) ---
# Privy server wallet. This is the Mainnet path. Create the wallet in the
# Privy dashboard, then paste its id and address.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_WALLET_ID=
# PRIVY_WALLET_ADDRESS=
# Local private key. Sepolia dev only. The router refuses to use this on Mainnet.
# ROUTER_PRIVATE_KEY=0x...

# --- x402 facilitator ---
# Leave unset with ALLOW_DEV_BYPASS=true for Sepolia dev without a facilitator.
# For any paid traffic, set a facilitator that supports Celo.
# X402_FACILITATOR_URL=
# API key for the facilitator's settlement call. Celo's facilitator requires
# X-API-Key on /settle (verify stays open). Get one at https://x402.celo.org:
# connect a wallet, create a key, and paste it here. New accounts get free
# credits; without this the first real bounty fails at settlement with 401.
# X402_API_KEY=
# Dev bypass. Testnets only. The config refuses true on Mainnet.
ALLOW_DEV_BYPASS=true

# --- Bounty economics ---
BOUNTY_PRICE_USDC=0.05
RESPONSES_REQUIRED=3
BOUNTY_TTL_SECONDS=86400

# --- Attribution ---
BUILDER_TAG=celo_0107eaa60597
# Optional startup guard: when set, the router refuses to start unless
# BUILDER_TAG matches this slug's codeFromRepo derivation. Leave unset for
# platform-assigned codes (like ours), which no slug derives.

# --- ERC-8004 identity ---
# Public base URL of this app. The registry points at
# ${APP_URL}/agent-registration.json, served by app/agent-registration.json.
# APP_URL=https://your-app.vercel.app
# Set after scripts/register-agent.mts prints the id, then redeploy.
# ERC8004_AGENT_ID=

# --- Demo seed (scripts/seed-demo.mts) ---
# Fork rehearsals derive humans from the anvil test mnemonic (no keys
# needed). Mainnet seeds need one funded throwaway key per answer, in order.
# SEED_HUMAN_KEYS=0x...,0x...,0x...
# Local anvil fork of Mainnet for rehearsals (nothing real moves).
# SIM_RPC_URL=http://127.0.0.1:8545

# --- Requester agent (POST /api/requester/ask) ---
# Server-held key that pays the router's 402. Forks use an anvil test key;
# Mainnet needs a funded throwaway key (never the router wallet: the
# requester and the payee must be separate wallets for attribution).
# REQUESTER_PRIVATE_KEY=0x...
# ASK_URL= (defaults to this app's /api/ask)

# --- Welcome emails (POST /api/emails/welcome) ---
# Branded email sent once per new contributor wallet (Resend).
# Without these the route returns { skipped: true } and nothing breaks.
# RESEND_API_KEY=
# EMAIL_FROM=Scout <hello@example.com>

# --- Human page (app/human) ---
# Privy App ID for human login (email/SMS/Google + embedded wallets).
# Same Privy app as the server wallet; public value, safe in the client.
# NEXT_PUBLIC_PRIVY_APP_ID=
# Escrow address shown to humans (same as SCOUT_ESCROW_ADDRESS).
# NEXT_PUBLIC_SCOUT_ESCROW=
# Builder code humans' answer transactions are tagged with (ERC-8021).
# NEXT_PUBLIC_BUILDER_TAG=celo_0107eaa60597
# Fork rehearsals only: point embedded wallets at the local fork RPC so
# answers land on the fork. Leave unset on Mainnet.
# NEXT_PUBLIC_CHAIN_RPC=http://127.0.0.1:8546
# Any hosted LLM behind a key. Two protocols supported via AGENTROUTER_PROTOCOL:
#   anthropic = POST {base}/v1/messages with x-api-key (Brewkeg, Claude models)
#   openai    = POST {base}/chat/completions with Bearer key (AgentRouter GPT models)
# Without a key the router uses the deterministic stub, which is also the
# automatic fallback when the hosted API is unreachable, rate-limited, or
# returns no usable text (for example outside an off-peak window).
# AGENTROUTER_API_KEY=
# AGENTROUTER_BASE_URL=https://brewkeg.dev
# AGENTROUTER_MODEL=claude-opus-5
# AGENTROUTER_PROTOCOL=anthropic
